# Configuration du projet — voir README.md pour le détail de chaque variable.
# Copiez/adaptez ce fichier (notamment LATITUDE/LONGITUDE) pour votre installation.

# --- Stockage (chemins à l'intérieur des conteneurs, sur le volume partagé) ---
DB_PATH=/data/meteo.db
MODELS_DIR=/data/models

# --- Localisation utilisée pour interroger Open-Meteo ---
# 22 rue du Grand Port, 79000 Niort
LATITUDE=46.3197
LONGITUDE=-0.5306
TIMEZONE=Europe/Paris

# --- Capteur BME280 ---
SENSOR_I2C_PORT=1
SENSOR_I2C_ADDRESS=0x77
SENSOR_INTERVAL_SECONDS=60
# Mettre à true pour tester sans capteur (génère des valeurs simulées).
SENSOR_MOCK=false

# --- Synchronisation météo (Open-Meteo) ---
WEATHER_SYNC_INTERVAL_MINUTES=60
WEATHER_HISTORY_START_DATE=2024-01-01
FORECAST_DAYS=16
WEATHER_PAST_DAYS=5

# --- Entraînement / prédiction ---
TRAIN_INTERVAL_HOURS=24
MIN_TRAINING_ROWS=72
TEST_FRACTION=0.2
FORECAST_HORIZON_HOURS=48
PREDICT_INTERVAL_MINUTES=30

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
